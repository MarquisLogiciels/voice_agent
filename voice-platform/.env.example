# Copy to .env (never commit .env). VP_* are platform settings; provider keys are read by
# the LiveKit plugins / provider registry.
VP_ENVIRONMENT=dev
VP_JWT_SECRET=change-me-to-64-random-characters
VP_ENCRYPTION_KEYS=            # generate with: vp gen-key   (comma-separate for rotation)
VP_TELEPHONY_DRY_RUN=true      # true = validate but never dial or transfer
VP_OUTBOUND_ALLOWED_PREFIXES=["+1514555"]
VP_LIVEKIT_SIP_URI=
VP_SIMULATOR_LLM=openai:gpt-4.1-mini
VP_JUDGE_LLM=anthropic:claude-haiku-4-5
VP_OPTIMIZER_LLM=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ELEVEN_API_KEY=
CARTESIA_API_KEY=
LIVEKIT_SIP_OUTBOUND_TRUNK=
